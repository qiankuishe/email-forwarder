# 复制为 .env 后填写：cp .env.example .env && chmod 600 .env
# .env 已在 .gitignore 中，切勿提交到公开仓库。

# ---------- 收信网关 ----------
# 网关准入密钥：生成方式 `openssl rand -hex 32`。
# 与主项目后台「网关路由」里的「网关准入密钥」保持一致（可在后台对该路由点「轮换」时一并更新）。
REGISTER_AUTH_TOKEN=
REQUIRE_REGISTER_AUTH=true
# 轮换准入密钥时把旧值放这里，主项目改用新值后删掉
REGISTER_AUTH_TOKEN_PREVIOUS=
# MX 记录指向的主机名（证书也签这个名字）
GATEWAY_DOMAIN=mx.300031.xyz
# 可选：本地重试缓冲（默认关闭）
# SPOOL_DIR=/app/data/spool

# ---------- IMAP/SMTP 客户端代理（可选，docker compose --profile proxy up -d） ----------
# 主项目 API 地址
API_BASE_URL=https://api.cee.edu.pl
# 主 API FRONTEND_URL 白名单中的任意一个前端地址（CSRF 校验需要）
API_ORIGIN=https://mail.300031.xyz
# 客户端连接用的主机名（证书需覆盖它），例如 mail.300031.xyz
PROXY_HOSTNAME=mail.300031.xyz
# login = 用网页登录密码（会与网页会话互相顶掉，见 README）；
# app-password = 用主 API 的「应用专用密码」（推荐）：用户名填平台账号邮箱 = 整个账户，填某个邮箱地址 = 只看这一个邮箱
PROXY_AUTH_MODE=login
# 与主 API 的 Workers secret PROXY_SHARED_SECRET 相同（至少 32 个字符，例如 openssl rand -hex 32）。
# 设置后代理请求主 API 时带 X-Proxy-Auth，主 API 才会信任 X-Client-IP（真实客户端 IP，用于按 IP 限流与「最近使用 IP」）。
# 留空则不发送，主 API 看到的客户端 IP 都是这台 VPS。
PROXY_SHARED_SECRET=
