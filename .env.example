# 复制为 .env 后填写：cp .env.example .env && chmod 600 .env
# .env 已在 .gitignore 中，切勿提交到公开仓库。

# ---------- 收信网关 ----------
# 网关准入密钥：生成方式 `openssl rand -hex 32`。
# 与主项目后台「网关路由」里的「网关准入密钥」保持一致（可在后台对该路由点「轮换」时一并更新）。
REGISTER_AUTH_TOKEN=
REQUIRE_REGISTER_AUTH=true
# 轮换准入密钥时把旧值放这里，主项目改用新值后删掉
REGISTER_AUTH_TOKEN_PREVIOUS=
# MX 记录指向的主机名（证书也签这个名字）
GATEWAY_DOMAIN=mx.300031.xyz
# 可选：本地重试缓冲（默认关闭）
# SPOOL_DIR=/app/data/spool
